rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'sushanta.careerjob@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdminEmail() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'employeeId', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'employeeId', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.employeeId is string && data.employeeId.size() >= 2 && data.employeeId.size() <= 32
        && data.employeeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.role in ['technician', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidFaultType(val) {
      return val in [
        'Bulb / Lamp Failure',
        'Ballast / Driver Fault',
        'Wiring / Short Circuit',
        'Photocell / Timer Fault',
        'Fuse / MCB Tripped',
        'Pole Structural Damage',
        'Other'
      ];
    }

    function isValidInspectionStatus(val) {
      return val in ['Resolved', 'Pending Follow-up', 'Escalated'];
    }

    function isValidInspection(data) {
      return data.keys().hasAll([
          'poleNo', 'inspectionDate', 'location', 'faultType',
          'partReplaced', 'remarks', 'status',
          'technicianId', 'technicianName', 'technicianBadge',
          'adminNotes', 'lastEditedByUid', 'lastEditedByName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'poleNo', 'inspectionDate', 'location', 'faultType',
          'partReplaced', 'remarks', 'status',
          'technicianId', 'technicianName', 'technicianBadge',
          'adminNotes', 'lastEditedByUid', 'lastEditedByName',
          'createdAt', 'updatedAt'
        ])
        && data.poleNo is string && data.poleNo.size() >= 2 && data.poleNo.size() <= 40
        && data.poleNo.matches('^[a-zA-Z0-9_\\-\\/\\.# ]+$')
        && data.inspectionDate is string && data.inspectionDate.size() == 10
        && data.inspectionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.location is string && data.location.size() <= 120
        && data.faultType is string && data.faultType.size() <= 60 && isValidFaultType(data.faultType)
        && data.partReplaced is string && data.partReplaced.size() >= 1 && data.partReplaced.size() <= 100
        && data.remarks is string && data.remarks.size() >= 1 && data.remarks.size() <= 1000
        && data.status is string && data.status.size() <= 30 && isValidInspectionStatus(data.status)
        && data.technicianId is string && isValidId(data.technicianId)
        && data.technicianName is string && data.technicianName.size() >= 1 && data.technicianName.size() <= 80
        && data.technicianBadge is string && data.technicianBadge.size() >= 1 && data.technicianBadge.size() <= 32
        && data.adminNotes is string && data.adminNotes.size() <= 500
        && data.lastEditedByUid is string && data.lastEditedByUid.size() <= 128
        && data.lastEditedByName is string && data.lastEditedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} (PII Isolated to Owner or Admin) ---
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().email == request.auth.token.email && (
            incoming().role == 'technician' || isBootstrappedAdminEmail()
          ))
          || isAdmin()
        );
      allow update: if isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().email == existing().email
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'employeeId', 'updatedAt']))
          || (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'employeeId', 'role', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();
    }

    // --- Collection: /admins/{userId} ---
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAdminGrant(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().grantedBy == request.auth.uid
        && (
          (isBootstrappedAdminEmail() && userId == request.auth.uid)
          || isAdmin()
        );
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(userId) && userId != request.auth.uid && isAdmin();
    }

    // --- Collection: /inspections/{inspectionId} ---
    match /inspections/{inspectionId} {
      allow get: if isVerifiedUser()
        && isValidId(inspectionId)
        && (existing().technicianId == request.auth.uid || isAdmin());

      allow list: if isVerifiedUser()
        && (resource.data.technicianId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(inspectionId)
        && isValidInspection(incoming())
        && (incoming().technicianId == request.auth.uid || isAdmin())
        && incoming().adminNotes == ''
        && incoming().lastEditedByUid == ''
        && incoming().lastEditedByName == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidInspection(incoming())
        && isValidId(inspectionId)
        && isAdmin()
        && incoming().technicianId == existing().technicianId
        && incoming().technicianName == existing().technicianName
        && incoming().technicianBadge == existing().technicianBadge
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().lastEditedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'poleNo', 'inspectionDate', 'location', 'faultType',
          'partReplaced', 'remarks', 'status',
          'adminNotes', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser() && isValidId(inspectionId) && isAdmin();
    }
  }
}
